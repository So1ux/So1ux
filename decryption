_G.entry = function(payload, secretKeyForExecutionOnly, codeExecute)
	if secretKeyForExecutionOnly and type(secretKeyForExecutionOnly) == 'string' and secretKeyForExecutionOnly == '__2008' then
		local code = codeExecute
		local func = MiniLoadstring.load(code, 'encryption', env)
		func()
		return
	end
	local raw = b64decode(payload)

	-- first 4 bytes = seed
	local b1, b2, b3, b4 = raw:byte(1, 4)
	local seed = b1 * 16777216 + b2 * 65536 + b3 * 256 + b4

	local encoded = raw:sub(5)
	local len = #encoded	

	local jumbled = {}
	for i = 1, len do
		jumbled[i] = encoded:byte(i)
	end

	local rng = newRNG(seed)

	-- regenerate same shifts
	local shifts = {}
	for i = 1, len do
		shifts[i] = rng(0, 255)
	end

	-- regenerate same shuffle order
	local order = {}
	for i = 1, len do order[i] = i end
	for i = len, 2, -1 do
		local j = rng(1, i)
		order[i], order[j] = order[j], order[i]
	end

	local bytes = {}
	for i = 1, len do
		bytes[i] = jumbled[order[i]]
	end

	local chars = {}
	for i = 1, len do
		chars[i] = string.char((bytes[i] - shifts[i]) % 256)
	end

	local code = table.concat(chars)
	local func = MiniLoadstring.load(code, 'encryption', env)
	func()

end

