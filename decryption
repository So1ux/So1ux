-- 4. EVALUATOR — walks the AST against a scope chain + environment table
--------------------------------------------------------------------------

local function newScope(parent)
	return { vars = {}, declared = {}, parent = parent, varargs = nil }
end

--------------------------------------------------------------------------
-- 5. load() — ties lexer + parser + evaluator together, mirrors loadstring
--------------------------------------------------------------------------

function MiniLoadstring.load(source, chunkname, customEnv)
	chunkname = chunkname or "MiniLoadstring"

	local okTok, tokensOrErr = pcall(tokenize, source)
	if not okTok then
		return nil, ("%s: %s"):format(chunkname, tostring(tokensOrErr))
	end

	local okParse, astOrErr = pcall(parse, tokensOrErr)
	if not okParse then
		return nil, ("%s: %s"):format(chunkname, tostring(astOrErr))
	end
	local ast = astOrErr

	local env = customEnv or makeDefaultEnv()

	-- forward declarations for the mutually-recursive eval/exec functions
	local evalExpr, evalMulti, evalExprList, evalTable, evalBinop, evalUnop
	local execStmt, execBlock, assignTarget, makeFunction

	local function scopeGet(scope, name)
		local s = scope
		while s do
			if s.declared[name] then return s.vars[name] end
			s = s.parent
		end
		return env[name]
	end

	local function scopeSet(scope, name, value)
		local s = scope
		while s do
			if s.declared[name] then
				s.vars[name] = value
				return
			end
			s = s.parent
		end
		env[name] = value
	end

	local function findVarargs(scope)
		local s = scope
		while s do
			if s.varargs then return s.varargs, s.varargsN or 0 end
			s = s.parent
		end
		return {}, 0
	end

	assignTarget = function(target, value, scope)
		if target.type == "Name" then
			scopeSet(scope, target.name, value)
		elseif target.type == "Index" then
			local obj = evalExpr(target.obj, scope)
			local key = evalExpr(target.key, scope)
			if obj == nil then
				error("attempt to index a nil value" .. (target.dot and (" (field '" .. tostring(key) .. "')") or ""))
			end
			obj[key] = value
		end
	end

	makeFunction = function(node, defScope)
		return function(...)
			local nargs = select("#", ...)
			local args = { ... }
			local fnScope = newScope(defScope)
			for idx, pname in ipairs(node.params) do
				fnScope.vars[pname] = args[idx]
				fnScope.declared[pname] = true
			end
			local varargsTbl, vCount = {}, 0
			if node.isVararg then
				for idx = #node.params + 1, nargs do
					vCount = vCount + 1
					varargsTbl[vCount] = args[idx]
				end
			end
			fnScope.varargs = varargsTbl
			fnScope.varargsN = vCount
			local signal = execBlock(node.body, fnScope)
			if signal and signal.type == "return" then
				return unpackFn(signal.values, 1, signal.n)
			end
			return nil
		end
	end

	evalTable = function(node, scope)
		local tbl = {}
		local arrIndex = 1
		local nFields = #node.fields
		for i, field in ipairs(node.fields) do
			if field.key == nil then
				local v = field.value
				if i == nFields and (v.type == "Call" or v.type == "MethodCall" or v.type == "Vararg") then
					local vals, vn = evalMulti(v, scope)
					for j = 1, vn do
						tbl[arrIndex] = vals[j]
						arrIndex = arrIndex + 1
					end
				else
					tbl[arrIndex] = evalExpr(v, scope)
					arrIndex = arrIndex + 1
				end
			else
				tbl[evalExpr(field.key, scope)] = evalExpr(field.value, scope)
			end
		end
		return tbl
	end

	evalBinop = function(node, scope)
		local op = node.op
		if op == "and" then
			local l = evalExpr(node.left, scope)
			if not l then return l end
			return evalExpr(node.right, scope)
		elseif op == "or" then
			local l = evalExpr(node.left, scope)
			if l then return l end
			return evalExpr(node.right, scope)
		end
		local l, r = evalExpr(node.left, scope), evalExpr(node.right, scope)
		if op == "+" then return l + r
		elseif op == "-" then return l - r
		elseif op == "*" then return l * r
		elseif op == "/" then return l / r
		elseif op == "%" then return l % r
		elseif op == "^" then return l ^ r
		elseif op == ".." then return tostring(l) .. tostring(r)
		elseif op == "==" then return l == r
		elseif op == "~=" then return l ~= r
		elseif op == "<" then return l < r
		elseif op == ">" then return l > r
		elseif op == "<=" then return l <= r
		elseif op == ">=" then return l >= r
		end
		error("unknown binary operator: " .. tostring(op))
	end

	evalUnop = function(node, scope)
		local v = evalExpr(node.expr, scope)
		if node.op == "-" then return -v
		elseif node.op == "not" then return not v
		elseif node.op == "#" then return #v
		end
	end

	-- evalMulti returns (list, n): n is the exact number of values, tracked
	-- explicitly rather than via #list, because #list is undefined once a
	-- nil could be among the values (e.g. an argument that evaluated to nil).
	evalMulti = function(node, scope)
		local t = node.type
		if t == "Call" then
			local func = evalExpr(node.func, scope)
			if type(func) ~= "function" then
				error("attempt to call a " .. type(func) .. " value")
			end
			local argsList, argsN = evalExprList(node.args, scope)
			local results = packFn(func(unpackFn(argsList, 1, argsN)))
			return results, results.n
		elseif t == "MethodCall" then
			local obj = evalExpr(node.obj, scope)
			local func = obj[node.method]
			if type(func) ~= "function" then
				error("attempt to call a " .. type(func) .. " value (method '" .. node.method .. "')")
			end
			local argsList, argsN = evalExprList(node.args, scope)
			local fullArgs = { obj }
			for j = 1, argsN do fullArgs[j + 1] = argsList[j] end
			local results = packFn(func(unpackFn(fullArgs, 1, argsN + 1)))
			return results, results.n
		elseif t == "Vararg" then
			local vs, vn = findVarargs(scope)
			local copy = {}
			for idx = 1, vn do copy[idx] = vs[idx] end
			return copy, vn
		else
			return { evalExpr(node, scope) }, 1
		end
	end

	-- Also returns (list, n) for the same reason as evalMulti.
	evalExprList = function(list, scope)
		local result, n = {}, 0
		local nList = #list
		for i, expr in ipairs(list) do
			if i == nList and (expr.type == "Call" or expr.type == "MethodCall" or expr.type == "Vararg") then
				local vals, vn = evalMulti(expr, scope)
				for j = 1, vn do
					n = n + 1
					result[n] = vals[j]
				end
			else
				n = n + 1
				result[n] = evalExpr(expr, scope)
			end
		end
		return result, n
	end

	evalExpr = function(node, scope)
		local t = node.type
		if t == "Nil" then return nil
		elseif t == "True" then return true
		elseif t == "False" then return false
		elseif t == "Number" then return node.value
		elseif t == "String" then return node.value
		elseif t == "Vararg" then return (findVarargs(scope))[1]
		elseif t == "Name" then return scopeGet(scope, node.name)
		elseif t == "Paren" then return evalExpr(node.expr, scope)
		elseif t == "Index" then
			local obj = evalExpr(node.obj, scope)
			if obj == nil then
				local key = evalExpr(node.key, scope)
				error("attempt to index a nil value" .. (node.dot and (" (field '" .. tostring(key) .. "')") or ""))
			end
			return obj[evalExpr(node.key, scope)]
		elseif t == "Call" or t == "MethodCall" then
			return (evalMulti(node, scope))[1]
		elseif t == "Function" then return makeFunction(node, scope)
		elseif t == "Table" then return evalTable(node, scope)
		elseif t == "Binop" then return evalBinop(node, scope)
		elseif t == "Unop" then return evalUnop(node, scope)
		end
		error("unknown expression node: " .. tostring(t))
	end

	execBlock = function(block, scope)
		for _, stmt in ipairs(block.stmts) do
			local signal = execStmt(stmt, scope)
			if signal then return signal end
		end
		return nil
	end

	execStmt = function(node, scope)
		local t = node.type
		if t == "Local" then
			local values = evalExprList(node.values, scope)
			for i, name in ipairs(node.names) do
				scope.vars[name] = values[i]
				scope.declared[name] = true
			end
		elseif t == "LocalFunction" then
			scope.declared[node.name] = true
			scope.vars[node.name] = makeFunction(node.func, scope)
		elseif t == "Assign" then
			local values = evalExprList(node.values, scope)
			for i, target in ipairs(node.targets) do
				assignTarget(target, values[i], scope)
			end
		elseif t == "ExprStat" then
			evalMulti(node.expr, scope)
		elseif t == "If" then
			for _, clause in ipairs(node.clauses) do
				if evalExpr(clause.cond, scope) then
					return execBlock(clause.body, newScope(scope))
				end
			end
			if node.elseBody then
				return execBlock(node.elseBody, newScope(scope))
			end
		elseif t == "While" then
			while evalExpr(node.cond, scope) do
				local signal = execBlock(node.body, newScope(scope))
				if signal then
					if signal.type == "break" then break end
					return signal
				end
			end
		elseif t == "Repeat" then
			while true do
				local loopScope = newScope(scope)
				local signal = execBlock(node.body, loopScope)
				if signal then
					if signal.type == "break" then break end
					return signal
				end
				if evalExpr(node.cond, loopScope) then break end
			end
		elseif t == "NumericFor" then
			local i = evalExpr(node.start, scope)
			local stopV = evalExpr(node.stop, scope)
			local stepV = node.step and evalExpr(node.step, scope) or 1
			if stepV == 0 then error("'for' step is zero") end
			while (stepV > 0 and i <= stopV) or (stepV < 0 and i >= stopV) do
				local loopScope = newScope(scope)
				loopScope.vars[node.var] = i
				loopScope.declared[node.var] = true
				local signal = execBlock(node.body, loopScope)
				if signal then
					if signal.type == "break" then break end
					return signal
				end
				i = i + stepV
			end
		elseif t == "GenericFor" then
			local vals = evalExprList(node.exprs, scope)
			local f, s, control = vals[1], vals[2], vals[3]
			while true do
				local results = { f(s, control) }
				if results[1] == nil then break end
				control = results[1]
				local loopScope = newScope(scope)
				for idx, name in ipairs(node.names) do
					loopScope.vars[name] = results[idx]
					loopScope.declared[name] = true
				end
				local signal = execBlock(node.body, loopScope)
				if signal then
					if signal.type == "break" then break end
					return signal
				end
			end
		elseif t == "Do" then
			return execBlock(node.body, newScope(scope))
		elseif t == "Return" then
			local vals, n = evalExprList(node.values, scope)
			return { type = "return", values = vals, n = n }
		elseif t == "Break" then
			return { type = "break" }
		else
			error("unknown statement type: " .. tostring(t))
		end
		return nil
	end

	local rootScope = newScope(nil)
	rootScope.varargs, rootScope.varargsN = {}, 0

	local runner = function(...)
		rootScope.varargsN = select("#", ...)
		rootScope.varargs = { ... }
		local ok, signalOrErr = pcall(execBlock, ast, rootScope)
		if not ok then
			error(("%s: %s"):format(chunkname, tostring(signalOrErr)), 0)
		end
		if signalOrErr and signalOrErr.type == "return" then
			return unpackFn(signalOrErr.values, 1, signalOrErr.n)
		end
		return nil
	end

	return runner, nil
end

